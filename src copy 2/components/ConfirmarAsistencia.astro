---
// ComponenteConfirmarAsistencia.astro
---

<section class="relative bg-white w-full mt-8 py-4 px-6 overflow-hidden">

    <!-- Hojas decorativas a la izquierda -->
    <div class="pointer-events-none absolute top-[64%] -left-10 sm:-left-12 md:-left-14 -translate-y-1/2 w-28 sm:w-36 md:w-44 z-0">
        <img
            src="/imagenes/hojas.webp"
            alt="Hojas decorativas"
            class="w-full h-auto object-contain"
            style="opacity: 0.25;"
                loading="lazy"
                decoding="async"
            />
    </div>

    <div class="relative z-10 max-w-lg mx-auto text-center">
        
        <!-- Título "Confirma tu Asistencia" -->
        <div id="titulo-asistencia" class="mt-2 mb-9">
            <h3 class="font-great-vibes text-5xl sm:text-6xl md:text-7xl leading-[1.15] text-[#810100] tracking-wide">
                Confirma tu Asistencia
            </h3>
        </div>

        <!-- Texto explicativo -->
        <div id="texto-asistencia" class="mb-6">
            <p class="text-[#1B1717] text-sm sm:text-base font-serif leading-relaxed">
                SERÁ DE MUCHA ALEGRÍA PARA NOSOTROS CONTAR<br />
                CON TU COMPAÑÍA EN ESTE DÍA TAN IMPORTANTE.
            </p>
        </div>

        <!-- Texto de confirmación -->
        <div id="texto-fecha-limite" class="mb-8">
            <p class="text-[#810100] text-sm sm:text-base font-serif leading-relaxed">
                AGRADECEMOS CONFIRMAR TU ASISTENCIA<br />
                CON NUESTRO<br />
                <strong class="font-bold tracking-[0.08em]">WEDDING PLANNER</strong>
            </p>
            <p class="mt-3 text-[#810100] text-base sm:text-lg font-serif tracking-[0.15em]">
                +591 73799479
            </p>
        </div>

        <!-- Botón "CONFIRMAR ASISTENCIA" -->
      <!-- Botón "CONFIRMAR ASISTENCIA" -->
<div id="boton-asistencia">
    <a
        href="https://wa.me/59173799479?text=Me%20complace%20confirmar%20mi%20asistencia%20a%20la%20boda%20de%20Valeria%20y%20Andr%C3%A9s.%20Nos%20vemos%20el%20s%C3%A1bado%2007%20de%20noviembre.%20%C2%A1Estar%C3%A9%20sin%20falta!"
        target="_blank"
        rel="noopener"
        class="group relative inline-block bg-[#810100] text-white px-10 py-3.5 rounded-lg text-sm sm:text-base font-serif uppercase tracking-[0.2em] hover:bg-[#5C0100] hover:-translate-y-0.5 transition-all duration-300 shadow-md hover:shadow-lg"
    >
        <span class="pointer-events-none absolute inset-1.5 rounded border border-white/30 transition-all duration-300 group-hover:inset-[7px]"></span>
        <span class="relative">Confirmar asistencia</span>
    </a>
</div>


    </div>

</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        console.log("✉️ Iniciando animaciones de confirmar asistencia...");

        // ═══ TÍTULO "CONFIRMA TU ASISTENCIA" ═══
        gsap.fromTo(
            "#titulo-asistencia",
            { opacity: 0, y: -30 },
            {
                opacity: 1,
                y: 0,
                duration: 0.8,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#titulo-asistencia",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                }
            }
        );

        // ═══ TEXTO EXPLICATIVO ═══
        gsap.fromTo(
            "#texto-asistencia",
            { opacity: 0, y: 20 },
            {
                opacity: 1,
                y: 0,
                duration: 0.8,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#texto-asistencia",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                },
                delay: 0.3
            }
        );

        // ═══ TEXTO FECHA LÍMITE ═══
        gsap.fromTo(
            "#texto-fecha-limite",
            { opacity: 0, y: 20 },
            {
                opacity: 1,
                y: 0,
                duration: 0.8,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#texto-fecha-limite",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                },
                delay: 0.5
            }
        );

        // ═══ BOTÓN "CONFIRMAR ASISTENCIA" ═══
        gsap.fromTo(
            "#boton-asistencia",
            { opacity: 0, scale: 0.8 },
            {
                opacity: 1,
                scale: 1,
                duration: 0.8,
                ease: "back.out(1.5)",
                scrollTrigger: {
                    trigger: "#boton-asistencia",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                },
                delay: 0.7
            }
        );

        console.log("✨ Animaciones de confirmar asistencia completadas!");
    });
</script>

<style>
    /* Efecto hover en el título */
    #titulo-asistencia:hover {
        transform: scale(1.05);
        transition: transform 0.3s ease;
    }

    /* Animación del botón al hacer clic */
    #boton-asistencia a:active {
        transform: scale(0.95);
    }
</style>