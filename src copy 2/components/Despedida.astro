---
// ComponenteNombresAroFinal.astro
---

<section id="despedida" class="relative bg-white w-full pt-2 pb-14 px-4 sm:px-6 overflow-hidden">

    <!-- Hojas decorativas: arriba a la izquierda -->
    <div class="pointer-events-none absolute -top-6 -left-12 sm:-left-14 w-28 sm:w-36 md:w-44 z-0">
        <img
            src="/imagenes/hojas.webp"
            alt="Hojas decorativas"
            class="w-full h-auto object-contain"
            style="opacity: 0.22;"
            loading="lazy"
            decoding="async"
        />
    </div>

    <!-- Hojas decorativas: abajo a la derecha -->
    <div id="despedida-hoja" class="pointer-events-none absolute -bottom-8 -right-12 sm:-right-14 w-28 sm:w-36 md:w-44 z-0">
        <img
            src="/imagenes/hojas.webp"
            alt="Hojas decorativas"
            class="w-full h-auto object-contain scale-x-[-1]"
            style="opacity: 0.22;"
            loading="lazy"
            decoding="async"
        />
    </div>

    <div class="relative z-10 max-w-lg mx-auto">

        <!-- Bloque final (sin marco) -->
        <div id="despedida-card" class="relative px-2 sm:px-6 pt-2 pb-8 text-center">

            <div class="relative">

                <!-- Antetítulo -->
                <p id="despedida-kicker" class="font-serif text-[#810100]/80 text-[0.68rem] sm:text-xs uppercase tracking-[0.32em] mb-8 sm:mb-10">
                    Gracias por acompañarnos
                </p>

                <!-- Aro con los nombres de los novios -->
                <div class="relative w-full flex justify-center">
                    <div class="relative w-56 h-56 sm:w-72 sm:h-72 md:w-80 md:h-80">
                        <img
                            id="despedida-aro"
                            src="/imagenes/aro.webp"
                            alt="Aro decorativo"
                            class="w-full h-full object-contain"
                            loading="lazy"
                            decoding="async"
                        />

                        <!-- Nombres de los novios centrados -->
                        <div class="absolute inset-0 flex flex-col items-center justify-center">
                            <h2 id="despedida-nombre-john" class="font-great-vibes text-[2.75rem] sm:text-6xl md:text-7xl leading-none text-[#810100] tracking-wide">
                                Valeria
                            </h2>
                            <div id="despedida-ampersand" class="text-[#810100] text-3xl sm:text-4xl md:text-5xl font-charm my-1.5">
                                &
                            </div>
                            <h2 id="despedida-nombre-damarys" class="font-great-vibes text-[2.75rem] sm:text-6xl md:text-7xl leading-none text-[#810100] tracking-wide">
                                Andrés
                            </h2>
                        </div>
                    </div>
                </div>

                <!-- Divisor ornamental -->
                <div id="despedida-divisor" class="flex items-center justify-center gap-4 mb-5 -mt-1">
                    <span class="block w-12 sm:w-16 h-px bg-gradient-to-r from-transparent to-[#810100]/70"></span>
                    <span class="text-[#810100] text-sm leading-none">&#10070;</span>
                    <span class="block w-12 sm:w-16 h-px bg-gradient-to-l from-transparent to-[#810100]/70"></span>
                </div>

                <!-- Mensaje -->
                <p id="despedida-mensaje" class="font-serif text-[#1B1717] text-sm sm:text-base tracking-[0.12em] leading-relaxed">
                    NOS HARÁ MUY FELICES<br />CONTAR CON TU PRESENCIA
                </p>

                <!-- Cierre en caligrafía -->
                <p id="despedida-cierre" class="mt-5 font-great-vibes text-[#810100] text-[clamp(2rem,9vw,3rem)] leading-tight">
                    ¡Te esperamos!
                </p>

            </div>

        </div>

    </div>

</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        console.log("💍 Iniciando animaciones de nombres en aro final...");

        const stCard = { trigger: "#despedida-card", start: "top 85%", toggleActions: "play none none reverse" };

        // ═══ BLOQUE FINAL ═══
        gsap.fromTo(
            "#despedida-card",
            { opacity: 0, y: 40 },
            { opacity: 1, y: 0, duration: 1, ease: "power3.out", scrollTrigger: stCard }
        );

        // ═══ ANTETÍTULO "GRACIAS POR ACOMPAÑARNOS" ═══
        gsap.fromTo(
            "#despedida-kicker",
            { opacity: 0, y: -12 },
            { opacity: 1, y: 0, duration: 0.8, ease: "power2.out", delay: 0.25, scrollTrigger: stCard }
        );

        // ═══ ARO DECORATIVO - Scale desde el centro ═══
        gsap.fromTo(
            "#despedida-aro",
            { opacity: 0, scale: 0.3, rotation: -10 },
            {
                opacity: 1,
                scale: 1,
                rotation: 0,
                duration: 1,
                ease: "back.out(1.7)",
                scrollTrigger: {
                    trigger: "#despedida-aro",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                }
            }
        );

        // ═══ ROTACIÓN SUAVE DEL ARO (loop infinito) ═══
        // Pausada mientras el aro no esté en pantalla: antes giraba desde
        // el segundo 1.5 aunque el usuario estuviera arriba del todo.
        const rotacionAroFinal = gsap.to("#despedida-aro", {
            rotation: 5,
            duration: 3,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
            delay: 1.5,
            paused: true
        });

        ScrollTrigger.create({
            trigger: "#despedida-aro",
            start: "top bottom",
            end: "bottom top",
            onToggle: ({ isActive }) => {
                if (isActive) rotacionAroFinal.play();
                else rotacionAroFinal.pause();
            }
        });

        // ═══ NOMBRE OMAR - Letra por letra ═══
        const textoNovio = "Valeria";
        const contenedorNovio = document.getElementById("despedida-nombre-john");
        if (contenedorNovio) {
            contenedorNovio.innerHTML = textoNovio
                .split("")
                .map(
                    (letra) =>
                        `<span class="letra-animada" style="
                            opacity: 0;
                            display: inline-block;
                            transform: translateY(20px) scale(0.8);
                            filter: blur(3px);
                        ">${letra}</span>`
                )
                .join("");

            gsap.to("#despedida-nombre-john .letra-animada", {
                opacity: 1,
                y: 0,
                scale: 1,
                filter: "blur(0px)",
                duration: 0.5,
                ease: "power2.out",
                stagger: { each: 0.05, from: "start" },
                delay: 0.5
            });
        }

        // ═══ SÍMBOLO & - Scale con bounce ═══
        gsap.fromTo(
            "#despedida-ampersand",
            { opacity: 0, scale: 0.5 },
            { opacity: 1, scale: 1, duration: 0.6, ease: "back.out(2)", delay: 0.9 }
        );

        // ═══ NOMBRE VALENTINA - Letra por letra ═══
        const textoNovia = "Andrés";
        const contenedorNovia = document.getElementById("despedida-nombre-damarys");
        if (contenedorNovia) {
            contenedorNovia.innerHTML = textoNovia
                .split("")
                .map(
                    (letra) =>
                        `<span class="letra-animada" style="
                            opacity: 0;
                            display: inline-block;
                            transform: translateY(20px) scale(0.8);
                            filter: blur(3px);
                        ">${letra}</span>`
                )
                .join("");

            gsap.to("#despedida-nombre-damarys .letra-animada", {
                opacity: 1,
                y: 0,
                scale: 1,
                filter: "blur(0px)",
                duration: 0.5,
                ease: "power2.out",
                stagger: { each: 0.05, from: "start" },
                delay: 1.1
            });
        }

        // ═══ DIVISOR / MENSAJE / BOTÓN ═══
        gsap.fromTo(
            "#despedida-divisor",
            { opacity: 0, scaleX: 0.4 },
            {
                opacity: 1,
                scaleX: 1,
                duration: 0.8,
                ease: "power2.out",
                scrollTrigger: { trigger: "#despedida-divisor", start: "top 85%", toggleActions: "play none none reverse" }
            }
        );

        gsap.fromTo(
            "#despedida-mensaje",
            { opacity: 0, y: 20 },
            {
                opacity: 1,
                y: 0,
                duration: 0.8,
                ease: "power2.out",
                delay: 0.2,
                scrollTrigger: { trigger: "#despedida-divisor", start: "top 85%", toggleActions: "play none none reverse" }
            }
        );

        // ═══ CIERRE "¡TE ESPERAMOS!" ═══
        gsap.fromTo(
            "#despedida-cierre",
            { opacity: 0, y: 20, scale: 0.9 },
            {
                opacity: 1,
                y: 0,
                scale: 1,
                duration: 0.9,
                ease: "back.out(1.4)",
                delay: 0.4,
                scrollTrigger: { trigger: "#despedida-divisor", start: "top 85%", toggleActions: "play none none reverse" }
            }
        );

        console.log("✨ Animaciones de nombres en aro final completadas!");
    });
</script>

<style>
    /* Efecto hover en letras animadas.
       Sin "will-change" permanente: obligaba al celular a mantener una
       capa de GPU por cada letra durante toda la visita. */
    .letra-animada {
        position: relative;
    }


    /* El hover solo existe con mouse; en celular no se aplica nada */
    @media (hover: hover) {
        .letra-animada {
            transition: transform 0.3s ease, text-shadow 0.3s ease;
        }

        .letra-animada:hover {
            transform: translateY(-3px) scale(1.1) !important;
            text-shadow: 0 0 15px rgba(129, 1, 0, 0.5) !important;
        }
    }
</style>
