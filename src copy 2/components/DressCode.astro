---
// ComponenteDressCode.astro
---

<section class="relative bg-white w-full mt-10 py-10 overflow-hidden">

    <div class="relative max-w-2xl mx-auto z-10">

        <!-- Tarjeta con fondo verde oliva -->
        <div id="dress-container" class="relative bg-[#810100] rounded-lg p-8 sm:p-10 text-center shadow-2xl overflow-hidden">

            <!-- Hoja decorativa a la izquierda -->
            <div id="hojas-dress" class="pointer-events-none absolute top-1/2 -left-10 sm:-left-12 md:-left-14 -translate-y-1/2 w-28 sm:w-36 md:w-44 z-0">
                <img
                    src="/imagenes/hojas.webp"
                    alt="Hojas decorativas"
                    class="w-full h-auto object-contain"
                    style="filter: brightness(0) invert(1); opacity: 0.25;"
                loading="lazy"
                decoding="async"
            />
            </div>

            <!-- Borde interior fino dorado (detalle elegante) -->
            <span class="pointer-events-none absolute inset-3 sm:inset-4 border border-[#DCDEDB]/30 rounded"></span>

            <div class="relative z-10">

                <!-- Título "Código de Vestimenta" -->
                <div id="titulo-dress" class="mb-2">
                    <h3 class="font-great-vibes text-[clamp(2.1rem,8.8vw,3.5rem)] leading-tight text-white tracking-wide whitespace-nowrap">
                        Código de Vestimenta
                    </h3>
                </div>

                <!-- Imagen de vestimenta -->
                <div id="imagen-vestimenta" class="mb-4 flex justify-center">
                    <div
                        role="img"
                        aria-label="Traje formal para caballeros y damas"
                        class="w-28 h-24 sm:w-36 sm:h-32"
                        style="background-color: #FFFFFF; -webkit-mask: url('/imagenes/vestimenta.png') center / contain no-repeat; mask: url('/imagenes/vestimenta.png') center / contain no-repeat;"
                    ></div>
                </div>

                <!-- Divisor ornamental -->
                <div class="flex items-center justify-center gap-3 mb-5">
                    <span class="block w-12 sm:w-16 h-px bg-gradient-to-r from-transparent to-[#DCDEDB]"></span>
                    <span class="text-[#DCDEDB] text-sm leading-none">&#10070;</span>
                    <span class="block w-12 sm:w-16 h-px bg-gradient-to-l from-transparent to-[#DCDEDB]"></span>
                </div>

                <!-- Subtítulo "TRAJE FORMAL" -->
                <div id="subtitulo-formal" class="mb-3">
                    <p class="text-[#DCDEDB] text-base sm:text-lg md:text-xl font-serif uppercase tracking-[0.25em]">
                        Traje Formal
                    </p>
                </div>

                <!-- Texto: colores reservados -->
                <div id="texto-evitar">
                    <p class="text-white/90 text-sm sm:text-base font-serif tracking-[0.12em] uppercase leading-relaxed">
                        Agradecemos evitar el vestido blanco en damas<br />
                        y la camisa negra en caballeros
                    </p>
                </div>

            </div>

        </div>

    </div>

</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        console.log("👔 Iniciando animaciones de código de vestimenta...");

        // ═══ TÍTULO "CÓDIGO DE VESTIMENTA" ═══
        gsap.fromTo(
            "#titulo-dress",
            { opacity: 0, y: -30 },
            {
                opacity: 1,
                y: 0,
                duration: 0.8,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#titulo-dress",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                },
                delay: 0.3
            }
        );

        // ═══ IMAGEN DE VESTIMENTA ═══
        gsap.fromTo(
            "#imagen-vestimenta",
            { opacity: 0, scale: 0.6 },
            {
                opacity: 1,
                scale: 1,
                duration: 0.8,
                ease: "back.out(1.5)",
                scrollTrigger: {
                    trigger: "#imagen-vestimenta",
                    start: "top 85%",
                    toggleActions: "play none none reverse"
                },
                delay: 0.45
            }
        );

        // ═══ SUBTÍTULO "TRAJE FORMAL" ═══
        gsap.fromTo(
            "#subtitulo-formal",
            { opacity: 0, scale: 0.8 },
            {
                opacity: 1,
                scale: 1,
                duration: 0.6,
                ease: "back.out(1.5)",
                scrollTrigger: {
                    trigger: "#subtitulo-formal",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                },
                delay: 0.6
            }
        );

        // ═══ TEXTO "EVITAR EL COLOR BLANCO" ═══
        gsap.fromTo(
            "#texto-evitar",
            { opacity: 0, y: 20 },
            {
                opacity: 1,
                y: 0,
                duration: 0.6,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#texto-evitar",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                },
                delay: 0.9
            }
        );

        console.log("✨ Animaciones de código de vestimenta completadas!");
    });
</script>

<style>
    /* Efecto hover en título */
    #titulo-dress:hover {
        transform: scale(1.05);
        transition: transform 0.3s ease;
    }
</style>