---
// ComponenteCompartirFotos.astro
---

<section class="relative bg-white w-full py-16 px-6">
    
    <div class="max-w-md mx-auto">
        
        <!-- Tarjeta con borde redondeado -->
        <div 
            id="fotos-card"
            class="border-2 border-[#810100] rounded-3xl p-8 sm:p-10 bg-white shadow-lg text-center"
        >
            
            <!-- Icono de cámara -->
            <div id="icono-camara" class="mb-6 flex justify-center">
                <div class="w-24 h-24 sm:w-28 sm:h-28 flex items-center justify-center">
                    <div role="img" aria-label="Cámara" class="w-full h-full" style="background-color: #810100; -webkit-mask: url('/imagenes/camara.png') center / contain no-repeat; mask: url('/imagenes/camara.png') center / contain no-repeat;"></div>
                </div>
            </div>

            <!-- Texto explicativo -->
            <div id="texto-fotos" class="mb-8">
                <p class="text-[#3A3333] text-sm sm:text-base md:text-lg font-serif leading-relaxed">
                    TE INVITAMOS A COMPARTIR<br />
                    LOS MOMENTOS MÁS ESPECIALES<br />
                    DE NUESTRO EVENTO A TRAVÉS<br />
                    DE TUS FOTOGRAFÍAS
                </p>
            </div>

            <!-- Botón "COMPARTIR FOTOS" -->
            <div id="boton-fotos">
                <a
                    href="#"
                    target="_blank"
                    class="inline-block bg-[#810100] text-white px-8 py-3 rounded-lg text-sm sm:text-base font-serif uppercase tracking-wider hover:bg-[#5C0100] transition-all duration-300 shadow-md hover:shadow-lg"
                >
                    COMPARTIR FOTOS
                </a>
            </div>

        </div>

    </div>

</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        console.log("📷 Iniciando animaciones de compartir fotos...");

        // ═══ TARJETA PRINCIPAL ═══
        gsap.fromTo(
            "#fotos-card",
            { opacity: 0, scale: 0.8, y: 50 },
            {
                opacity: 1,
                scale: 1,
                y: 0,
                duration: 1,
                ease: "back.out(1.4)",
                scrollTrigger: {
                    trigger: "#fotos-card",
                    start: "top 80%",
                    once: true
                }
            }
        );

        // ═══ ICONO DE CÁMARA ═══
        gsap.fromTo(
            "#icono-camara",
            { opacity: 0, scale: 0.5, rotation: -15 },
            {
                opacity: 1,
                scale: 1,
                rotation: 0,
                duration: 0.8,
                ease: "back.out(1.7)",
                scrollTrigger: {
                    trigger: "#fotos-card",
                    start: "top 80%",
                    once: true
                },
                delay: 0.3
            }
        );

        // ═══ TEXTO EXPLICATIVO ═══
        gsap.fromTo(
            "#texto-fotos",
            { opacity: 0, y: 20 },
            {
                opacity: 1,
                y: 0,
                duration: 0.8,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#fotos-card",
                    start: "top 80%",
                    once: true
                },
                delay: 0.6
            }
        );

        // ═══ BOTÓN "COMPARTIR FOTOS" ═══
        gsap.fromTo(
            "#boton-fotos",
            { opacity: 0, y: 20 },
            {
                opacity: 1,
                y: 0,
                duration: 0.6,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#fotos-card",
                    start: "top 80%",
                    once: true
                },
                delay: 0.9
            }
        );

        // ═══ ANIMACIÓN DE FLASH EN LA CÁMARA ═══
        // gsap.to("#icono-camara", {
        //     scale: 1.1,
        //     duration: 0.3,
        //     ease: "power2.inOut",
        //     yoyo: true,
        //     repeat: -1,
        //     repeatDelay: 3,
        //     delay: 2
        // });

        console.log("✨ Animaciones de compartir fotos completadas!");
    });
</script>

<style>
    /* Transiciones suaves en la tarjeta */
    #fotos-card {
        transition: all 0.3s ease;
    }

    #fotos-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    }

    /* Efecto hover en el icono */
    #icono-camara:hover {
        transform: scale(1.1) rotate(5deg);
        transition: transform 0.3s ease;
    }

    /* Animación del botón */
    #boton-fotos a:active {
        transform: scale(0.95);
    }
</style>