---
// ComponentePase.astro - Pases asignados
export interface Props {
    pases?: number;
    mensaje?: string;
}

const { pases = 2, mensaje } = Astro.props;

// El mensaje se adapta a la cantidad de pases (se puede sobrescribir con la prop "mensaje")
const mensajePorDefecto =
    pases === 1
        ? "Esperamos contar con tu presencia"
        : pases === 2
          ? "Esperamos contar con la presencia de ambos"
          : "Esperamos contar con la presencia de todos";

const textoMensaje = mensaje ?? mensajePorDefecto;
---

<section class="relative bg-white w-full py-2">

    <div class="max-w-2xl mx-auto">

        <!-- Contenedor principal con fondo rojo -->
        <div
            id="pase-container"
            class="relative bg-[#810100] rounded-lg p-6 sm:p-8 text-center shadow-2xl overflow-hidden"
        >

            <!-- Borde interior fino (detalle elegante) -->
            <span class="pointer-events-none absolute inset-3 sm:inset-4 border border-[#DCDEDB]/30 rounded"></span>

            <div class="relative z-10 flex flex-col items-center">

                <!-- Ícono de pases -->
                <div id="icono-pase" class="mb-5 text-white">
                    <svg
                        class="w-20 h-14 sm:w-24 sm:h-16"
                        viewBox="0 0 72 48"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        role="img"
                        aria-label="Pases"
                    >
                        <!-- Pase de atrás -->
                        <path d="M10 8h40a2 2 0 0 1 2 2v2.5a3.5 3.5 0 0 0 0 7V22a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2v-2.5a3.5 3.5 0 0 0 0-7V10a2 2 0 0 1 2-2Z" />
                        <path d="M18 13h12M18 18h16" />
                        <path d="M43 9v14" stroke-dasharray="2 3" />

                        <!-- Pase de adelante -->
                        <path d="M22 24h40a2 2 0 0 1 2 2v2.5a3.5 3.5 0 0 0 0 7V38a2 2 0 0 1-2 2H22a2 2 0 0 1-2-2v-2.5a3.5 3.5 0 0 0 0-7V26a2 2 0 0 1 2-2Z" />
                        <path d="M30 29h12M30 34h16" />
                        <path d="M55 25v14" stroke-dasharray="2 3" />
                    </svg>
                </div>

                <!-- "PASES ASIGNADOS" -->
                <p id="texto-reservado" class="text-white text-sm sm:text-base font-serif uppercase tracking-[0.3em]">
                    Pases asignados
                </p>

                <!-- Número de pases -->
                <p id="numero-pase" class="mt-3 font-serif text-[#DCDEDB] text-[clamp(3rem,14vw,4.5rem)] leading-none">
                    {pases}
                </p>

                <!-- "PASES" con líneas a los costados -->
                <div id="texto-pase" class="mt-3 flex items-center justify-center gap-3">
                    <span class="block w-10 sm:w-14 h-px bg-gradient-to-r from-transparent to-[#DCDEDB]"></span>
                    <span class="text-[#DCDEDB] text-sm sm:text-base font-serif uppercase tracking-[0.3em]">
                        {pases === 1 ? "Pase" : "Pases"}
                    </span>
                    <span class="block w-10 sm:w-14 h-px bg-gradient-to-l from-transparent to-[#DCDEDB]"></span>
                </div>

                <!-- Mensaje -->
                <p id="texto-honor" class="mt-6 font-great-vibes text-white text-[clamp(1.5rem,6.5vw,2.1rem)] leading-snug">
                    {textoMensaje}
                </p>

                <!-- Avatares -->
                <div id="avatares-pase" class="mt-6 flex items-center justify-center gap-4">
                    {
                        Array.from({ length: pases }).map(() => (
                            <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white/10 border border-[#DCDEDB]/50 flex items-center justify-center">
                                <svg
                                    class="w-6 h-6 text-white"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.6"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <circle cx="12" cy="8.5" r="3.5" />
                                    <path d="M5 20a7 7 0 0 1 14 0" />
                                </svg>
                            </div>
                        ))
                    }
                </div>

            </div>

        </div>

    </div>

</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        console.log("🎟️ Iniciando animaciones de pase...");

        const st = { trigger: "#pase-container", start: "top 80%", toggleActions: "play none none reverse" };

        // ═══ TARJETA PRINCIPAL ═══
        gsap.fromTo(
            "#pase-container",
            { opacity: 0, scale: 0.92, y: 50 },
            { opacity: 1, scale: 1, y: 0, duration: 1, ease: "power2.out", scrollTrigger: st }
        );

        // ═══ ÍCONO DE PASES ═══
        gsap.fromTo(
            "#icono-pase",
            { opacity: 0, y: -20, rotation: -8 },
            { opacity: 1, y: 0, rotation: 0, duration: 0.8, ease: "back.out(1.6)", scrollTrigger: st, delay: 0.3 }
        );

        // ═══ "PASES ASIGNADOS" ═══
        gsap.fromTo(
            "#texto-reservado",
            { opacity: 0, letterSpacing: "0.6em" },
            { opacity: 1, letterSpacing: "0.3em", duration: 0.8, ease: "power2.out", scrollTrigger: st, delay: 0.6 }
        );

        // ═══ NÚMERO DE PASES ═══
        gsap.fromTo(
            "#numero-pase",
            { opacity: 0, scale: 0.3, rotation: -12 },
            { opacity: 1, scale: 1, rotation: 0, duration: 1, ease: "back.out(2)", scrollTrigger: st, delay: 0.85 }
        );

        // ═══ "PASES" CON LÍNEAS ═══
        gsap.fromTo(
            "#texto-pase",
            { opacity: 0, scaleX: 0.5 },
            { opacity: 1, scaleX: 1, duration: 0.7, ease: "power2.out", scrollTrigger: st, delay: 1.15 }
        );

        // ═══ MENSAJE ═══
        gsap.fromTo(
            "#texto-honor",
            { opacity: 0, y: 20 },
            { opacity: 1, y: 0, duration: 0.7, ease: "power2.out", scrollTrigger: st, delay: 1.35 }
        );

        // ═══ AVATARES ═══
        gsap.fromTo(
            "#avatares-pase > div",
            { opacity: 0, scale: 0.5 },
            { opacity: 1, scale: 1, duration: 0.6, ease: "back.out(1.8)", stagger: 0.15, scrollTrigger: st, delay: 1.55 }
        );

        console.log("✨ Animaciones de pase completadas!");
    });
</script>

<style>
    .font-great-vibes {
        font-family: "Great Vibes", cursive;
    }

    #pase-container {
        transition: all 0.3s ease;
    }

    #numero-pase {
        display: inline-block;
        transition: transform 0.3s ease;
    }

    #numero-pase:hover {
        transform: scale(1.06);
    }
</style>
