---
// src/layouts/Layout.astro
import '../styles/global.css';
export interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="es" class="m-0 p-0">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Fuerza modo claro: el navegador NO debe aplicar su tema oscuro -->
    <meta name="color-scheme" content="only light" />
    <meta name="supported-color-schemes" content="light" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" type="image/png" href="/iconos/Anillos.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
     <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Crimson+Text:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Crimson+Text:wght@400;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Charm:wght@400;700&display=swap" rel="stylesheet">
    
    <style>
      /* ═══ MODO CLARO FORZADO ═══
         Evita que el modo oscuro del navegador/sistema invierta fondos,
         textos, formularios o el auto-dark de Chrome en Android. */
      :root {
        color-scheme: only light;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

     html {
    width: 100%;
    height: 100%;
    overflow-x: hidden; /* ← Elimina scroll horizontal */
    color-scheme: only light;
    background-color: #FFFFFF;
    /* Evita que iOS/Android reajusten el tamaño de texto */
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
}

body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100vh;
    overflow-x: hidden; /* ← Elimina scroll horizontal */
    /* Fondo blanco limpio, sin degradados */
    background-color: #FFFFFF;
    background-image: none;
    color: var(--negro);
    color-scheme: only light;
}

      main {
        background: transparent !important;
      }

      /* Los inputs/botones tampoco deben tomar el tema oscuro del sistema */
      input,
      textarea,
      select,
      button {
        color-scheme: only light;
      }

      /* Modo de alto contraste de Windows: respeta el diseño original */
      @media (forced-colors: active) {
        html,
        body {
          forced-color-adjust: none;
          background-color: #FFFFFF;
        }
      }
    </style>
  </head>
  <body class="min-h-screen m-0 p-0">
    <main class="m-0 p-0 overflow-x-hidden">
      <slot />
    </main>
  </body>
</html>