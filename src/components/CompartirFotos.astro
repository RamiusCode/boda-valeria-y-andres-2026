---
// ComponenteCompartirFotos.astro
---

<section class="relative bg-white w-full py-16 px-6 overflow-hidden">

    <!-- Hojas decorativas a la derecha -->
    <div class="pointer-events-none absolute top-1/2 -right-8 sm:-right-10 -translate-y-1/2 w-20 sm:w-24 md:w-28 z-0">
        <img
            src="/imagenes/hojas.webp"
            alt="Hojas decorativas"
            class="w-full h-auto object-contain scale-x-[-1]"
            style="opacity: 0.25;"
                loading="lazy"
                decoding="async"
            />
    </div>

    <div class="relative z-10 max-w-md mx-auto">
        
        <!-- Tarjeta con borde redondeado -->
        <div
            id="fotos-card"
            class="relative border border-[#810100]/60 rounded-3xl p-8 sm:p-10 bg-white shadow-lg text-center overflow-hidden"
        >

            <!-- Borde interior fino (detalle elegante) -->
            <span class="pointer-events-none absolute inset-3 sm:inset-4 border border-[#810100]/25 rounded-2xl"></span>

            <div class="relative">

                <!-- Título "Comparte tus Fotos" -->
                <div id="titulo-fotos" class="mb-2">
                    <h3 class="font-great-vibes text-[clamp(2.1rem,8.8vw,3.5rem)] leading-tight text-[#810100] tracking-wide whitespace-nowrap">
                        Comparte tus Fotos
                    </h3>
                </div>

                <!-- Divisor ornamental -->
                <div class="flex items-center justify-center gap-3 mb-5">
                    <span class="block w-10 sm:w-14 h-px bg-gradient-to-r from-transparent to-[#810100]/70"></span>
                    <span class="w-1.5 h-1.5 rotate-45 bg-[#1B1717]"></span>
                    <span class="block w-10 sm:w-14 h-px bg-gradient-to-l from-transparent to-[#810100]/70"></span>
                </div>

                <!-- Icono de cámara -->
                <div id="icono-camara" class="mb-5 flex justify-center">
                    <div class="w-16 h-16 sm:w-20 sm:h-20 flex items-center justify-center">
                        <div role="img" aria-label="Cámara" class="w-full h-full" style="background-color: #810100; -webkit-mask: url('/imagenes/camara.png') center / contain no-repeat; mask: url('/imagenes/camara.png') center / contain no-repeat;"></div>
                    </div>
                </div>

                <!-- Texto explicativo -->
                <div id="texto-fotos" class="mb-6">
                    <p class="text-[#1B1717] text-sm font-serif tracking-[0.12em] leading-relaxed">
                        Te invitamos a compartir<br />
                        los momentos más especiales<br />
                        de nuestro evento a través<br />
                        de tus fotografías.
                    </p>
                </div>

                <!-- Botón "COMPARTIR FOTOS" -->
                <div id="boton-fotos">
                    <a
                        href="#"
                        target="_blank"
                        rel="noopener"
                        class="group relative inline-block bg-[#810100] text-white px-9 py-3 rounded-lg text-sm sm:text-base font-serif uppercase tracking-[0.2em] hover:bg-[#5C0100] transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5"
                    >
                        <span class="pointer-events-none absolute inset-1.5 rounded border border-white/30 transition-all duration-300 group-hover:inset-[7px]"></span>
                        <span class="relative">Compartir fotos</span>
                    </a>
                </div>

            </div>

        </div>

    </div>

</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        console.log("📷 Iniciando animaciones de compartir fotos...");

        // ═══ TARJETA PRINCIPAL ═══
        gsap.fromTo(
            "#fotos-card",
            { opacity: 0, scale: 0.8, y: 50 },
            {
                opacity: 1,
                scale: 1,
                y: 0,
                duration: 1,
                ease: "back.out(1.4)",
                scrollTrigger: {
                    trigger: "#fotos-card",
                    start: "top 80%",
                    once: true
                }
            }
        );

        // ═══ TÍTULO ═══
        gsap.fromTo(
            "#titulo-fotos",
            { opacity: 0, y: -20 },
            {
                opacity: 1,
                y: 0,
                duration: 0.8,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#fotos-card",
                    start: "top 80%",
                    once: true
                },
                delay: 0.2
            }
        );

        // ═══ ICONO DE CÁMARA ═══
        gsap.fromTo(
            "#icono-camara",
            { opacity: 0, scale: 0.5, rotation: -15 },
            {
                opacity: 1,
                scale: 1,
                rotation: 0,
                duration: 0.8,
                ease: "back.out(1.7)",
                scrollTrigger: {
                    trigger: "#fotos-card",
                    start: "top 80%",
                    once: true
                },
                delay: 0.3
            }
        );

        // ═══ TEXTO EXPLICATIVO ═══
        gsap.fromTo(
            "#texto-fotos",
            { opacity: 0, y: 20 },
            {
                opacity: 1,
                y: 0,
                duration: 0.8,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#fotos-card",
                    start: "top 80%",
                    once: true
                },
                delay: 0.6
            }
        );

        // ═══ BOTÓN "COMPARTIR FOTOS" ═══
        gsap.fromTo(
            "#boton-fotos",
            { opacity: 0, y: 20 },
            {
                opacity: 1,
                y: 0,
                duration: 0.6,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#fotos-card",
                    start: "top 80%",
                    once: true
                },
                delay: 0.9
            }
        );

        // ═══ ANIMACIÓN DE FLASH EN LA CÁMARA ═══
        // gsap.to("#icono-camara", {
        //     scale: 1.1,
        //     duration: 0.3,
        //     ease: "power2.inOut",
        //     yoyo: true,
        //     repeat: -1,
        //     repeatDelay: 3,
        //     delay: 2
        // });

        console.log("✨ Animaciones de compartir fotos completadas!");
    });
</script>

<style>
    .font-great-vibes {
        font-family: 'Great Vibes', cursive;
    }

    /* Transiciones suaves en la tarjeta */
    #fotos-card {
        transition: all 0.3s ease;
    }

    #fotos-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    }

    /* Efecto hover en el icono */
    #icono-camara:hover {
        transform: scale(1.1) rotate(5deg);
        transition: transform 0.3s ease;
    }

    /* Animación del botón */
    #boton-fotos a:active {
        transform: scale(0.95);
    }
</style>