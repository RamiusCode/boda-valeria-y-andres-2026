---
// ComponenteNombresAroFinal.astro
---

<section class="relative bg-white w-full py-4 px-6">

    <!-- Contenedor del aro con nombres -->
    <div class="relative w-full flex justify-center">
        <div class="relative w-64 h-64 sm:w-80 sm:h-80 md:w-96 md:h-96">
            <!-- Imagen del aro -->
            <img
                id="despedida-aro"
                src="/imagenes/aro.webp"
                alt="Aro decorativo"
                class="w-full h-full object-contain"
            />

            <!-- Hoja decorativa abajo a la derecha, junto a los nombres -->
            <div id="despedida-hoja" class="pointer-events-none absolute -bottom-24 -right-8 w-24 sm:w-28 md:w-32 z-0">
                <img
                    src="/imagenes/hojas.png"
                    alt="Hojas decorativas"
                    class="w-full h-auto object-contain scale-x-[-1]"
                    style="opacity: 0.25;"
                />
            </div>

            <!-- Nombres de los novios centrados -->
            <div class="absolute inset-0 flex flex-col items-center justify-center">
                <h2 id="despedida-nombre-john" class="font-great-vibes text-5xl sm:text-6xl md:text-7xl text-[#810100] tracking-wide">
                    Valeria
                </h2>
                <div id="despedida-ampersand" class="text-[#810100] text-3xl sm:text-4xl md:text-5xl font-charm my-2">
                    &
                </div>
                <h2 id="despedida-nombre-damarys" class="font-great-vibes text-5xl sm:text-6xl md:text-7xl text-[#810100] tracking-wide">
                    Andrés
                </h2>
            </div>
        </div>
    </div>

    <!-- Mensaje de despedida + confirmación -->
    <div class="max-w-md mx-auto text-center flex flex-col items-center px-6 mt-2">

        <!-- Divisor ornamental -->
        <div id="despedida-divisor" class="flex items-center justify-center gap-4 mb-5">
            <span class="block w-12 sm:w-16 h-px bg-gradient-to-r from-transparent to-[#810100]/70"></span>
            <span class="text-[#810100] text-sm leading-none">&#10070;</span>
            <span class="block w-12 sm:w-16 h-px bg-gradient-to-l from-transparent to-[#810100]/70"></span>
        </div>

        <!-- Mensaje -->
        <p id="despedida-mensaje" class="font-serif text-[#1B1717] text-sm sm:text-base tracking-[0.12em] leading-relaxed">
            NOS HARÁ MUY FELICES<br />CONTAR CON TU PRESENCIA
        </p>

    </div>

</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        console.log("💍 Iniciando animaciones de nombres en aro final...");

        // ═══ ARO DECORATIVO - Scale desde el centro ═══
        gsap.fromTo(
            "#despedida-aro",
            { opacity: 0, scale: 0.3, rotation: -10 },
            {
                opacity: 1,
                scale: 1,
                rotation: 0,
                duration: 1,
                ease: "back.out(1.7)",
                scrollTrigger: {
                    trigger: "#despedida-aro",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                }
            }
        );

        // ═══ ROTACIÓN SUAVE DEL ARO (loop infinito) ═══
        gsap.to("#despedida-aro", {
            rotation: 5,
            duration: 3,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
            delay: 1.5
        });

        // ═══ NOMBRE OMAR - Letra por letra ═══
        const textoNovio = "Valeria";
        const contenedorNovio = document.getElementById("despedida-nombre-john");
        if (contenedorNovio) {
            contenedorNovio.innerHTML = textoNovio
                .split("")
                .map(
                    (letra) =>
                        `<span class="letra-animada" style="
                            opacity: 0;
                            display: inline-block;
                            transform: translateY(20px) scale(0.8);
                            filter: blur(3px);
                        ">${letra}</span>`
                )
                .join("");

            gsap.to("#despedida-nombre-john .letra-animada", {
                opacity: 1,
                y: 0,
                scale: 1,
                filter: "blur(0px)",
                duration: 0.5,
                ease: "power2.out",
                stagger: { each: 0.05, from: "start" },
                delay: 0.5
            });
        }

        // ═══ SÍMBOLO & - Scale con bounce ═══
        gsap.fromTo(
            "#despedida-ampersand",
            { opacity: 0, scale: 0.5 },
            { opacity: 1, scale: 1, duration: 0.6, ease: "back.out(2)", delay: 0.9 }
        );

        // ═══ NOMBRE VALENTINA - Letra por letra ═══
        const textoNovia = "Andrés";
        const contenedorNovia = document.getElementById("despedida-nombre-damarys");
        if (contenedorNovia) {
            contenedorNovia.innerHTML = textoNovia
                .split("")
                .map(
                    (letra) =>
                        `<span class="letra-animada" style="
                            opacity: 0;
                            display: inline-block;
                            transform: translateY(20px) scale(0.8);
                            filter: blur(3px);
                        ">${letra}</span>`
                )
                .join("");

            gsap.to("#despedida-nombre-damarys .letra-animada", {
                opacity: 1,
                y: 0,
                scale: 1,
                filter: "blur(0px)",
                duration: 0.5,
                ease: "power2.out",
                stagger: { each: 0.05, from: "start" },
                delay: 1.1
            });
        }

        // ═══ DIVISOR / MENSAJE / BOTÓN ═══
        gsap.fromTo(
            "#despedida-divisor",
            { opacity: 0, scaleX: 0.4 },
            {
                opacity: 1,
                scaleX: 1,
                duration: 0.8,
                ease: "power2.out",
                scrollTrigger: { trigger: "#despedida-divisor", start: "top 85%", toggleActions: "play none none reverse" }
            }
        );

        gsap.fromTo(
            "#despedida-mensaje",
            { opacity: 0, y: 20 },
            {
                opacity: 1,
                y: 0,
                duration: 0.8,
                ease: "power2.out",
                delay: 0.2,
                scrollTrigger: { trigger: "#despedida-divisor", start: "top 85%", toggleActions: "play none none reverse" }
            }
        );

        console.log("✨ Animaciones de nombres en aro final completadas!");
    });
</script>

<style>
    /* Efecto hover en letras animadas */
    .letra-animada {
        transition: all 0.3s ease;
        will-change: transform, opacity, filter;
        position: relative;
    }

    .letra-animada:hover {
        transform: translateY(-3px) scale(1.1) !important;
        text-shadow: 0 0 15px rgba(129, 1, 0, 0.5) !important;
    }
</style>
