---
// ComponenteCeremonia.astro
---

<section class="relative bg-white w-full py-4 px-6 overflow-hidden">

    <!-- Hojas decorativas a la derecha -->
    <div class="pointer-events-none absolute top-1/2 -right-10 sm:-right-12 md:-right-14 -translate-y-1/2 w-28 sm:w-36 md:w-44 z-0">
        <img
            src="/imagenes/hojas.webp" width="500" height="862"
            alt="Hojas decorativas"
            class="w-full h-auto object-contain scale-x-[-1]"
            style="opacity: 0.25;"
                loading="lazy"
                decoding="async"
            />
    </div>

    <div class="relative z-10 max-w-md mx-auto">
        
        <!-- Tarjeta con borde redondeado -->
        <div
            id="ceremonia-card"
            class="relative border border-[#810100]/60 rounded-3xl p-8 sm:p-10 bg-white shadow-lg text-center overflow-hidden"
        >

            <!-- Borde interior fino (detalle elegante) -->
            <span class="pointer-events-none absolute inset-3 sm:inset-4 border border-[#810100]/25 rounded-2xl"></span>

            <div class="relative">

                <!-- Título "Ceremonia civil y recepción social" -->
                <div id="titulo-ceremonia" class="mb-2">
                    <h3 class="font-great-vibes text-[clamp(1.9rem,7.2vw,2.9rem)] leading-tight text-[#810100] tracking-wide">
                        Ceremonia civil<br />y recepción social
                    </h3>
                </div>

                <!-- Divisor ornamental -->
                <div class="flex items-center justify-center gap-3 mb-5">
                    <span class="block w-10 sm:w-14 h-px bg-gradient-to-r from-transparent to-[#810100]/70"></span>
                    <span class="w-1.5 h-1.5 rotate-45 bg-[#1B1717]"></span>
                    <span class="block w-10 sm:w-14 h-px bg-gradient-to-l from-transparent to-[#810100]/70"></span>
                </div>

                <!-- Icono de recepción -->
                <div id="icono-iglesia" class="mb-5 flex justify-center">
                    <div class="w-16 h-16 sm:w-20 sm:h-20 flex items-center justify-center">
                        <div role="img" aria-label="Recepción" class="w-full h-full" style="background-color: #810100; -webkit-mask: url('/imagenes/recepcion.png') center / contain no-repeat; mask: url('/imagenes/recepcion.png') center / contain no-repeat;"></div>
                    </div>
                </div>

                <!-- Nombre del salón -->
                <div id="nombre-salon" class="mb-5">
                    <p class="text-[#810100] text-sm sm:text-base md:text-lg font-serif tracking-[0.12em] leading-snug">
                        SALÓN<br />“VILLA BONITA”
                    </p>
                </div>

                <!-- Hora -->
                <div id="hora-ceremonia" class="mb-6">
                    <p class="text-sm sm:text-base md:text-lg text-[#1B1717] uppercase tracking-[0.25em] font-serif mb-2">Hora</p>
                    <p class="text-[#810100] text-[clamp(1.35rem,5.5vw,1.8rem)] font-serif tracking-wide leading-none">
                        15:30
                    </p>
                </div>

                <!-- Botón "VER UBICACIÓN" -->
                <div id="boton-ubicacion">
                    <a
                        href="https://maps.app.goo.gl/CWArYtACX73rYGC5A"
                        target="_blank"
                        class="group relative inline-block bg-[#810100] text-white px-9 py-3 rounded-lg text-sm sm:text-base font-serif uppercase tracking-[0.2em] hover:bg-[#5C0100] transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5"
                    >
                        <span class="pointer-events-none absolute inset-1.5 rounded border border-white/30 transition-all duration-300 group-hover:inset-[7px]"></span>
                        <span class="relative">Ver ubicación</span>
                    </a>
                </div>

            </div>

        </div>

    </div>

</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        console.log("⛪ Iniciando animaciones de ceremonia...");

        // ═══ TARJETA PRINCIPAL ═══
        gsap.fromTo(
            "#ceremonia-card",
            { opacity: 0, scale: 0.8, y: 50 },
            {
                opacity: 1,
                scale: 1,
                y: 0,
                duration: 1,
                ease: "back.out(1.4)",
                scrollTrigger: {
                    trigger: "#ceremonia-card",
                    start: "top 80%",
                    once: true
                }
            }
        );

        // ═══ ICONO DE IGLESIA ═══
        gsap.fromTo(
            "#icono-iglesia",
            { opacity: 0, scale: 0.5, rotation: -10 },
            {
                opacity: 1,
                scale: 1,
                rotation: 0,
                duration: 0.8,
                ease: "back.out(1.7)",
                scrollTrigger: {
                    trigger: "#ceremonia-card",
                    start: "top 80%",
                    once: true
                },
                delay: 0.3
            }
        );

        // ═══ TÍTULO "CEREMONIA RELIGIOSA" ═══
        gsap.fromTo(
            "#titulo-ceremonia",
            { opacity: 0, y: -20 },
            {
                opacity: 1,
                y: 0,
                duration: 0.8,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#ceremonia-card",
                    start: "top 80%",
                    once: true
                },
                delay: 0.6
            }
        );

        // ═══ HORA ═══
        gsap.fromTo(
            "#hora-ceremonia",
            { opacity: 0, scale: 0.7 },
            {
                opacity: 1,
                scale: 1,
                duration: 0.8,
                ease: "back.out(1.5)",
                scrollTrigger: {
                    trigger: "#ceremonia-card",
                    start: "top 80%",
                    once: true
                },
                delay: 0.9
            }
        );

        // ═══ NOMBRE DEL SALÓN ═══
        gsap.fromTo(
            "#nombre-salon",
            { opacity: 0, y: 20 },
            {
                opacity: 1,
                y: 0,
                duration: 0.6,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#ceremonia-card",
                    start: "top 80%",
                    once: true
                },
                delay: 1.2
            }
        );

        // ═══ BOTÓN "VER UBICACIÓN" ═══
        gsap.fromTo(
            "#boton-ubicacion",
            { opacity: 0, y: 20 },
            {
                opacity: 1,
                y: 0,
                duration: 0.6,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#ceremonia-card",
                    start: "top 80%",
                    once: true
                },
                delay: 1.5
            }
        );

        console.log("✨ Animaciones de ceremonia completadas!");
    });
</script>

<style>
    /* Transiciones suaves en la tarjeta */
    #ceremonia-card {
        transition: box-shadow 0.3s ease;
    }

    #ceremonia-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    }

    /* Efecto hover en el título */
    #titulo-ceremonia:hover {
        transform: scale(1.05);
        transition: transform 0.3s ease;
    }

    /* Animación del botón */
    #boton-ubicacion a:active {
        transform: scale(0.95);
    }
</style>