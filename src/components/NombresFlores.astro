---
// NombresFlores.astro (ComponenteInvitacion.astro)
---

<section id="nombresflores" class="relative w-full overflow-hidden">
    
    <!-- REPRODUCTOR DE MÚSICA - Fijo en la esquina inferior derecha -->
    <div id="reproductor-fijo" class="fixed bottom-4 right-4 z-40">

        <!-- Círculo del reproductor -->
        <button
            id="btn-reproducir"
            class="relative w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-gradient-to-br from-[#810100] to-[#5C0100] shadow-xl flex items-center justify-center border-2 border-white/60"
            title="Reproducir/Pausar música"
        >
            <!-- Ícono de PLAY: solo la nota musical (visible cuando está pausada) -->
            <svg
                id="icono-play"
                class="hidden w-9 h-9 sm:w-11 sm:h-11 text-white drop-shadow-lg"
                fill="currentColor"
                viewBox="0 0 24 24"
            >
                <!-- Plica (barra que une las notas) -->
                <path d="M8 5.9 L21 2.2 V4.6 L8 8.3 Z"/>
                <!-- Astas -->
                <rect x="8" y="5.7" width="1.3" height="13" />
                <rect x="19.7" y="2.3" width="1.3" height="13" />
                <!-- Cabezas de las notas -->
                <ellipse cx="5.6" cy="18.6" rx="3.2" ry="2.5" transform="rotate(-18 5.6 18.6)" />
                <ellipse cx="17.3" cy="15.2" rx="3.2" ry="2.5" transform="rotate(-18 17.3 15.2)" />
            </svg>

            <!-- Ícono de PAUSA: la misma nota con una línea en chanfle (visible mientras suena) -->
            <svg
                id="icono-pause"
                class="w-9 h-9 sm:w-11 sm:h-11 text-white drop-shadow-lg"
                fill="currentColor"
                viewBox="0 0 24 24"
            >
                <defs>
                    <mask id="mascara-chanfle">
                        <rect width="24" height="24" fill="white" />
                        <line x1="3" y1="21" x2="21" y2="3" stroke="black" stroke-width="3.6" stroke-linecap="round" />
                    </mask>
                </defs>

                <g mask="url(#mascara-chanfle)">
                    <!-- Plica (barra que une las notas) -->
                    <path d="M8 5.9 L21 2.2 V4.6 L8 8.3 Z"/>
                    <!-- Astas -->
                    <rect x="8" y="5.7" width="1.3" height="13" />
                    <rect x="19.7" y="2.3" width="1.3" height="13" />
                    <!-- Cabezas de las notas -->
                    <ellipse cx="5.6" cy="18.6" rx="3.2" ry="2.5" transform="rotate(-18 5.6 18.6)" />
                    <ellipse cx="17.3" cy="15.2" rx="3.2" ry="2.5" transform="rotate(-18 17.3 15.2)" />
                </g>

                <!-- Línea en chanfle -->
                <line x1="4" y1="20" x2="20" y2="4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
        </button>
    </div>

    <!-- Audio element (oculto) SIN autoplay -->
    <audio id="audio-player" preload="auto" loop>
        <source src="/audio/melodia.mp3" type="audio/mpeg">
        Tu navegador no soporta el elemento de audio.
    </audio>

    <!-- Imagen Principal con desvanecimiento -->
    <div class="relative w-full">
        <!-- Imagen principal -->
        <div class="relative w-fit max-w-full mx-auto">
            <img
                id="imagen-principal"
                src="/imagenes/foto1.webp"
                alt="Foto de los novios"
                class="max-w-full h-auto"
                width="1023"
                height="1270"
                fetchpriority="high"
                decoding="async"
            />

            <!-- Viñeta superior sutil para dar profundidad -->
            <div class="pointer-events-none absolute top-0 left-0 w-full h-28 bg-gradient-to-b from-black/15 to-transparent"></div>

            <!-- Degradado de desvanecimiento -->
            <div id="degradado" class="absolute bottom-0 left-0 w-full h-16 bg-gradient-to-t from-white to-transparent"></div>
        </div>
    </div>

    <!-- Texto de invitación -->
    <div id="texto-invitacion" class="relative w-full px-6 pt-4 pb-2 text-center flex flex-col items-center">

        <!-- Línea superior elegante -->
        <p class="font-serif text-[#810100] text-xs sm:text-sm tracking-[0.4em] uppercase mb-3">
            Con amor
        </p>

        <p class="font-serif text-[#1B1717] text-base sm:text-lg md:text-xl tracking-wide leading-relaxed">
            TENEMOS EL HONOR<br />
            DE INVITARTE A NUESTRA BODA
        </p>

        <!-- Divisor ornamental dorado -->
        <div id="divisor-texto" class="flex items-center gap-4 mt-4">
            <span class="block w-12 sm:w-20 h-px bg-gradient-to-r from-transparent to-[#810100]/70"></span>
            <span class="text-[#810100] text-base leading-none tracking-widest">&#10070;</span>
            <span class="block w-12 sm:w-20 h-px bg-gradient-to-l from-transparent to-[#810100]/70"></span>
        </div>
    </div>

    <!-- Contenedor del aro con nombres -->
    <div class="relative w-full flex justify-center pt-2 pb-8">

        <!-- Hojas decorativas a la izquierda -->
        <div id="hojas-izquierda" class="absolute top-1/2 -left-10 sm:-left-12 md:-left-14 -translate-y-1/2 w-28 sm:w-36 md:w-44 z-0 pointer-events-none">
            <img
                src="/imagenes/hojas.webp"
                alt=""
                class="w-full h-auto object-contain"
                style="opacity: 0.25;"
                width="500"
                height="862"
                loading="lazy"
                decoding="async"
            />
        </div>

        <div class="relative z-10 w-56 h-56 sm:w-72 sm:h-72 md:w-80 md:h-80">

            <!-- Imagen del aro -->
            <img
                id="aro-decorativo"
                src="/imagenes/aro.webp"
                alt=""
                class="relative w-full h-full object-contain"
                loading="lazy"
                decoding="async"
            />

            <!-- Nombres de los novios centrados -->
            <div class="absolute inset-0 flex flex-col items-center justify-center">
                <h2 id="nombre-john" class="font-great-vibes text-4xl sm:text-5xl md:text-6xl text-[#810100] tracking-wide">
                    Valeria
                </h2>
                <div id="ampersand" class="flex items-center gap-3 my-1">
                    <span class="w-6 sm:w-8 h-px bg-[#810100]/50"></span>
                    <span class="text-[#810100] text-3xl sm:text-4xl md:text-5xl font-charm">&amp;</span>
                    <span class="w-6 sm:w-8 h-px bg-[#810100]/50"></span>
                </div>
                <h2 id="nombre-damarys" class="font-great-vibes text-4xl sm:text-5xl md:text-6xl text-[#810100] tracking-wide">
                    Andrés
                </h2>
            </div>
        </div>
    </div>

</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP Y REPRODUCTOR                       -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const stNF = { trigger: "#nombresflores", start: "top 80%", toggleActions: "play none none reverse" };

    document.addEventListener("DOMContentLoaded", () => {
        console.log("🎊 Iniciando animaciones de invitación...");

        // ═══ REPRODUCTOR DE MÚSICA - Inicia automáticamente cuando se carga el componente ═══
        const audio = document.getElementById("audio-player") as HTMLAudioElement;
        const btnReproducir = document.getElementById("btn-reproducir");
        const iconoPlay = document.getElementById("icono-play");
        const iconoPause = document.getElementById("icono-pause");

        let estaReproduciendo = false;

        // Función para intentar reproducir con manejo de errores
        const intentarReproducir = async () => {
            try {
                await audio?.play();
                estaReproduciendo = true;
                iconoPlay?.classList.add("hidden");
                iconoPause?.classList.remove("hidden");
                console.log("🎵 Música iniciada automáticamente");
            } catch (error) {
                console.log("⚠️ No se pudo reproducir automáticamente, esperando interacción del usuario");
                estaReproduciendo = false;
                iconoPlay?.classList.remove("hidden");
                iconoPause?.classList.add("hidden");
            }
        };

        // ⭐ INICIAR MÚSICA SOLO AL PRESIONAR "INGRESAR" EN LA PORTADA
        // La portada dispara este evento al cerrarse
        window.addEventListener("iniciar-musica", () => {
            if (!estaReproduciendo) {
                intentarReproducir();
            }
        });

        // Funcionalidad del botón play/pause
        btnReproducir?.addEventListener("click", (e) => {
            e.stopPropagation(); // Evitar que active el listener de iniciarConInteraccion
            
            if (!estaReproduciendo) {
                // Reproducir música
                audio?.play();
                estaReproduciendo = true;
                
                // Cambiar iconos
                iconoPlay?.classList.add("hidden");
                iconoPause?.classList.remove("hidden");
                
            } else {
                // Pausar música
                audio?.pause();
                estaReproduciendo = false;
                
                // Cambiar iconos
                iconoPlay?.classList.remove("hidden");
                iconoPause?.classList.add("hidden");
            }
        });

        // Reiniciar cuando termine la canción (aunque tiene loop)
        audio?.addEventListener("ended", () => {
            estaReproduciendo = false;
            iconoPlay?.classList.remove("hidden");
            iconoPause?.classList.add("hidden");
        });

        // ═══ IMAGEN PRINCIPAL - Fade in desde arriba ═══
        gsap.fromTo(
            "#imagen-principal",
            { opacity: 0, y: -50 },
            { opacity: 1, y: 0, duration: 1, ease: "power2.out", delay: 0, scrollTrigger: stNF }
        );

        // ═══ DEGRADADO - Aparece después de la imagen ═══
        gsap.fromTo(
            "#degradado",
            { opacity: 0 },
            { opacity: 1, duration: 0.8, ease: "power2.out", delay: 0.5, scrollTrigger: stNF }
        );

        // ═══ TEXTO DE INVITACIÓN - Fade in desde abajo ═══
        gsap.fromTo(
            "#texto-invitacion",
            { opacity: 0, y: 30 },
            { opacity: 1, y: 0, duration: 0.8, ease: "power2.out", delay: 0.8, scrollTrigger: stNF }
        );

        // ═══ DIVISOR ORNAMENTAL - Aparece con el texto ═══
        gsap.fromTo(
            "#divisor-texto",
            { opacity: 0, scaleX: 0.4 },
            { opacity: 1, scaleX: 1, duration: 0.9, ease: "power2.out", delay: 1, scrollTrigger: stNF }
        );

        // ═══ HOJAS DECORATIVAS IZQUIERDA - Fade in suave ═══
        gsap.fromTo(
            "#hojas-izquierda",
            { opacity: 0, x: -30 },
            { opacity: 1, x: 0, duration: 1, ease: "power2.out", delay: 1.2, scrollTrigger: stNF }
        );

        // ═══ ARO DECORATIVO - Scale desde el centro ═══
        gsap.fromTo(
            "#aro-decorativo",
            { opacity: 0, scale: 0.3, rotation: -10 },
            { opacity: 1, scale: 1, rotation: 0, duration: 1, ease: "back.out(1.7)", delay: 1.2, scrollTrigger: stNF }
        );

        // ═══ NOMBRE JOHN - Letra por letra ═══
        const textoJohn = "Valeria";
        const contenedorJohn = document.getElementById("nombre-john");
        if (contenedorJohn) {
            contenedorJohn.innerHTML = textoJohn
                .split("")
                .map(
                    (letra, index) =>
                        `<span class="letra-animada" style="
                            opacity: 0; 
                            display: inline-block; 
                            transform: translateY(20px) scale(0.8);
                            filter: blur(3px);
                        ">${letra}</span>`
                )
                .join("");

            gsap.to("#nombre-john .letra-animada", {
                opacity: 1,
                y: 0,
                scale: 1,
                filter: "blur(0px)",
                duration: 0.5,
                ease: "power2.out",
                stagger: { each: 0.05, from: "start" },
                delay: 1.6
            });
        }

        // ═══ SÍMBOLO & - Scale con bounce ═══
        gsap.fromTo(
            "#ampersand",
            { opacity: 0, scale: 0.5 },
            { opacity: 1, scale: 1, duration: 0.6, ease: "back.out(2)", delay: 2 }
        );

        // ═══ NOMBRE DAMARYS - Letra por letra ═══
        const textoDamarys = "Andrés";
        const contenedorDamarys = document.getElementById("nombre-damarys");
        if (contenedorDamarys) {
            contenedorDamarys.innerHTML = textoDamarys
                .split("")
                .map(
                    (letra, index) =>
                        `<span class="letra-animada" style="
                            opacity: 0; 
                            display: inline-block; 
                            transform: translateY(20px) scale(0.8);
                            filter: blur(3px);
                        ">${letra}</span>`
                )
                .join("");

            gsap.to("#nombre-damarys .letra-animada", {
                opacity: 1,
                y: 0,
                scale: 1,
                filter: "blur(0px)",
                duration: 0.5,
                ease: "power2.out",
                stagger: { each: 0.05, from: "start" },
                delay: 2.2
            });
        }

        // ═══ ROTACIÓN SUAVE DEL ARO (loop infinito) ═══
        // Se pausa cuando el aro sale de pantalla: antes seguía girando
        // durante TODO el scroll y repintaba la imagen en cada cuadro,
        // que es lo que hacía sentir el deslizamiento trabado.
        const rotacionAro = gsap.to("#aro-decorativo", {
            rotation: 5,
            duration: 3,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
            delay: 3,
            paused: true
        });

        ScrollTrigger.create({
            trigger: "#aro-decorativo",
            start: "top bottom",
            end: "bottom top",
            onToggle: ({ isActive }) => {
                if (isActive) rotacionAro.play();
                else rotacionAro.pause();
            }
        });

        console.log("✨ Animaciones completadas!");
    });
</script>

<style>
    /* Asegurar que las imágenes carguen correctamente */
    img {
        display: block;
    }
    
    /* Efecto hover en letras animadas.
       Sin "will-change" permanente: obligaba al celular a mantener una
       capa de GPU por cada letra durante toda la visita. GSAP ya lo
       activa solo mientras dura la animación. */
    .letra-animada {
        position: relative;
    }

    /* El hover solo existe con mouse; en celular no se aplica nada */
    @media (hover: hover) {
        .letra-animada {
            transition: transform 0.3s ease, text-shadow 0.3s ease;
        }

        .letra-animada:hover {
            transform: translateY(-3px) scale(1.1) !important;
            text-shadow: 0 0 15px rgba(129, 1, 0, 0.5) !important;
        }
    }

    /* Responsivo */
    @media (max-width: 640px) {
        #reproductor-fijo {
            bottom: 0.75rem;
            right: 0.75rem;
        }
    }
</style>